{
	"name": "timezone-overlap",
	"compatibility_date": "2026-06-01",
	"assets": {
		"directory": "./public"
	},
	// wrangler 가 배포하면서 DNS 레코드까지 만든다. b7g.pro 존이 같은 계정에 있어야 하고,
	// Pages 쪽에는 커스텀 도메인을 붙이는 명령이 없어서 Workers 정적 자산으로 간다.
	"routes": [
		{ "pattern": "tz-overlap.b7g.pro", "custom_domain": true }
	]
}
